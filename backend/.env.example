# AI PROVIDER ROUTER
# Seleciona o provider ativo: "gemini" ou "openai"
AI_PROVIDER=gemini

# GOOGLE GEMINI (gratuito com limites)
# Obter chave: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_aqui

# OPENAI (pago)
# Obter chave: https://platform.openai.com/api-keys
# Preços: https://openai.com/api/pricing/
OPENAI_API_KEY=sua_chave_aqui

# SERVER
PORT=3000
