# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the key for the provider you want to use.
#   cp .env.example .env
#
# .env is git-ignored. NEVER commit real credentials.
#
# Only the key for the ACTIVE provider is required. To run with no
# credentials at all, set LLM_PROVIDER=stub.
# ---------------------------------------------------------------------------

# ---- Server ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated list, or * to allow any origin.
#
# * exists for development: `flutter run -d chrome` picks a new ephemeral port
# on every run, so a fixed origin would break the local flow. The app REFUSES
# TO START with * when NODE_ENV=production — list the real origins there.
CORS_ORIGINS=*

# ---- LLM provider ----
# openai      default. The brief asks for "OpenAI or Google AI".
# gemini      Google AI, the other option the brief allows.
# openrouter  gateway; handy for switching models, but not one of the two
#             providers the brief names. See ADR-0002.
# stub        deterministic, no network, no credentials. Useful to explore the
#             API contract without an API key.
LLM_PROVIDER=openai

LLM_TIMEOUT_MS=8000
# Too low makes the three suggestions nearly identical, which defeats asking
# for three. Too high produces text that reads oddly on a card.
LLM_TEMPERATURE=0.8
LLM_MAX_OUTPUT_TOKENS=400

# Retries apply ONLY to 5xx and network failures, and share the timeout budget
# above rather than multiplying it. Set to 0 to disable. See ADR-0003.
LLM_MAX_RETRIES=1
LLM_RETRY_BASE_DELAY_MS=300

# ---- Credentials (only the active provider's key is required) ----
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---- Cache ----
CACHE_ENABLED=true
CACHE_TTL_MS=600000
CACHE_MAX_ENTRIES=500

# ---- Rate limiting ----
# Every request that misses the cache costs real money in tokens. 30 per 5
# minutes per IP leaves roughly 6x headroom over human use while capping what
# abuse can spend. Blocked requests never reach the model. See ADR-0005.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=30

# How many reverse proxies sit in front of this process (0 = none).
# The rate limiter keys on the client IP; behind a proxy, every request would
# otherwise carry the proxy's address and one caller could spend everyone's
# quota. Set to 1 behind a single load balancer.
TRUST_PROXY_HOPS=0

# ---- API documentation ----
# Swagger UI at /docs and the OpenAPI document at /docs/openapi.json.
# Publishing the full API surface is a deliberate choice; a deployment that
# does not want it sets this to false.
DOCS_ENABLED=true
