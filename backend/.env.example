# === Gift Card Message Suggester — Backend configuration ===

# Google AI (Gemini) API key — get one at https://aistudio.google.com/apikey
# REQUIRED for real LLM calls. Without it the server still boots and always
# serves the deterministic fallback (useful for the fallback test / offline dev).
GEMINI_API_KEY=

# Gemini model id (defaults to gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# HTTP server
PORT=8080
HOST=0.0.0.0

# LLM call timeout in milliseconds (request aborts and falls back after this)
LLM_TIMEOUT_MS=8000

# Max retry attempts on transient LLM failures (429 / 5xx / network)
LLM_MAX_RETRIES=2

# Rate limiting (per IP)
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=1 minute

# Cache TTL for successful LLM responses, in milliseconds.
# DEFAULT 0 = DISABLED. For a creative feature, variety is the value: caching by
# input would make "generate again" return identical messages. Enable only if a
# usage profile justifies it (see README > Cost and caching).
CACHE_TTL_MS=0

# Comma-separated list of allowed CORS origins. Use * to allow all (dev only).
CORS_ORIGIN=*

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
