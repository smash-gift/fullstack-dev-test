# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the values you need.
#   cp .env.example .env
#
# .env is git-ignored. NEVER commit real credentials.
# Every variable below has a default, so the server boots with an empty .env
# while LLM_PROVIDER is "stub".
# ---------------------------------------------------------------------------

# ---- Server ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated list, or * to allow any origin (development only).
CORS_ORIGINS=*

# ---- LLM provider ----
# stub      no credentials, deterministic output (default while phase 03 is pending)
# openai    requires OPENAI_API_KEY        [phase 03]
# openrouter requires OPENROUTER_API_KEY   [phase 03]
# gemini    requires GEMINI_API_KEY        [phase 03]
LLM_PROVIDER=stub
LLM_TIMEOUT_MS=8000

# Only the key for the ACTIVE provider is required.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# ---- Cache ----
CACHE_ENABLED=true
CACHE_TTL_MS=600000
CACHE_MAX_ENTRIES=500
