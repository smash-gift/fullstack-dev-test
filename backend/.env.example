# ---------------------------------------------------------------------------
# The API runs without any of these. With no GEMINI_API_KEY it starts in
# fallback-only mode: every request returns curated messages with
# source="fallback" and degradedReason="not_configured".
# ---------------------------------------------------------------------------

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Only set to true behind a reverse proxy you control; it makes the rate
# limiter key on X-Forwarded-For instead of the socket address.
TRUST_PROXY=false

# Google AI Studio key: https://aistudio.google.com/apikey (free tier is enough)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Hard ceiling for a single LLM call, retries included.
LLM_TIMEOUT_MS=8000
LLM_MAX_RETRIES=1

# Per-IP fixed window.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Cost guard: LLM calls allowed per process per day. Past it, serve fallback.
DAILY_LLM_CALL_BUDGET=500

CACHE_ENABLED=true
CACHE_TTL_MS=3600000
CACHE_MAX_ENTRIES=500

# Comma-separated origins, or * for local development.
CORS_ORIGIN=*
