# ---------------------------------------------------------------------------
# Backend configuration
# Copy this file to `.env` and fill in the values.
# NOTE: The LLM key is intentionally left blank. Until it is set, the backend
# runs in "fallback-only" mode: it never calls the LLM and always returns the
# safe static suggestions. This lets you run the whole stack end-to-end without
# any external credentials.
# ---------------------------------------------------------------------------

# HTTP port the server listens on (defaults to 8080 if unset).
# NOTE: keep this commented if you use the Firebase emulator — Functions reserve
# the PORT key and will refuse to load a .env that sets it. The standalone
# server falls back to 8080 anyway.
# PORT=8080

# Comma-separated list of allowed CORS origins. Use * for any (dev only).
CORS_ORIGIN=*

# ----- LLM provider -----
# Which provider to use: "openai" | "gemini" | "mock".
# The provider abstraction makes this a one-line swap; only OpenAI is wired up
# for real calls in this test (see src/llm/). Leave the key blank to stay in
# fallback mode.
#
# "mock" needs no key, network, or local model: it returns varied, on-topic
# suggestions and reports source: "llm". Great for demos, CI, and reviewers who
# want to exercise the LLM path (and caching) without configuring anything —
# just set LLM_PROVIDER=mock.
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at any OpenAI-compatible endpoint. Leave blank for real OpenAI.
# Local Ollama example (free, no key): set OPENAI_BASE_URL to the line below,
# OPENAI_API_KEY to any placeholder (e.g. "ollama"), and OPENAI_MODEL to a
# pulled model such as "llama3.2".
#   OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_BASE_URL=

# Google AI (Gemini) — placeholder for the alternative provider.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Max milliseconds to wait for the LLM before treating it as a failure and
# falling back.
LLM_TIMEOUT_MS=8000

# ----- Rate limiting -----
# Max requests per window per client IP.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# ----- Cache -----
# In-memory cache TTL for identical (occasion, relationship) pairs, in ms.
# Set to 0 to disable.
CACHE_TTL_MS=300000
