# Server
PORT=3001
NODE_ENV=development

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_OUTPUT_TOKENS=600

# Message generation cache (Firestore, backend-only — see docs/specs/2026-08-12-backend-generation-improvements-design.md)
MESSAGE_CACHE_TTL_MS=21600000

# Firebase Admin (preparado para uso futuro — endpoints protegidos ainda não existem)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# CORS — origem do front-end (Web) autorizada a chamar este backend do navegador
CORS_ORIGIN=http://localhost:3000
