# Copy to backend/.env and fill in. `.env` is git-ignored and never leaves this machine.
# firebase-functions loads this file automatically for both the emulator and deploys.

# Required. Create at https://platform.openai.com -> API keys (needs billing credit).
OPENAI_API_KEY=sk-replace-me

# Model used for suggestions. Keep a small, cheap one.
OPENAI_MODEL=gpt-4o-mini

# Abort the LLM call after this many milliseconds and fall back.
LLM_TIMEOUT_MS=8000

# Rate limiting, per authenticated user.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# How long a cached suggestion set stays valid. Seconds, on purpose: this is a
# de-duplication window for a double tap or a quick reload, not a cost lever.
# Raising it saves money and costs variety.
CACHE_TTL_SECONDS=10

# Set to true to force every LLM call to fail. Lets you see the fallback path
# in the app without touching your API key.
FORCE_LLM_FAILURE=false

# Comma-separated origins allowed to call the API, or * for any.
ALLOWED_ORIGINS=*
