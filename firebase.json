{
  "functions": {
    "source": "backend",
    "ignore": ["node_modules", ".git", "src", "tests", "coverage", "*.log", ".env", ".env.*"],
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "emulators": {
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8085 },
    "ui": { "enabled": true, "port": 4001 },
    "singleProjectMode": true
  }
}
