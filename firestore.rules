rules_version = '2';

// All Firestore access happens server-side through the Admin SDK (in the Cloud
// Function), which bypasses these rules. Direct client access is therefore
// denied by default — the cache is an internal implementation detail.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
