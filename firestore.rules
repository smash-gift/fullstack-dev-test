rules_version = '2';

// Every read and write to Firestore goes through the Cloud Function, which uses
// the Admin SDK and therefore bypasses these rules. Clients hold no direct
// access: `rate_limits` would be trivially defeatable and `suggestion_cache`
// would leak other users' inputs. Denying everything here is the intended
// posture, not an unfinished ruleset.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
