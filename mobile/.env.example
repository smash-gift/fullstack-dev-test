# smash-gift — mobile — configuração de exemplo (sem valores reais)
#
# O Flutter não lê arquivos .env nativamente. Para evitar adicionar uma dependência extra
# (ex.: flutter_dotenv) só para isso, este projeto usa o mecanismo nativo de "dart-define" em
# tempo de compilação — ver docs/specs/2026-08-12-mobile-technical-design.md, seção
# "Configuração / variáveis de ambiente".
#
# Como usar este arquivo:
# 1. Copie para um arquivo real (ex.: `dart_defines.local.json`, ignorado pelo git) no formato:
#      {
#        "API_BASE_URL": "http://10.0.2.2:3001"
#      }
# 2. Rode com:
#      flutter run --dart-define-from-file=dart_defines.local.json
#    (ou passe cada chave individualmente com --dart-define=CHAVE=valor)
#
# Chaves suportadas hoje:

# URL base do backend (docs/contracts/api-contracts.md). Default de desenvolvimento aponta para
# o alias do emulador Android (10.0.2.2) para o localhost da máquina host.
API_BASE_URL=http://10.0.2.2:3001

# --- Firebase (FlutterFire) ---
# `main.dart` chama `Firebase.initializeApp(options: DefaultFirebaseOptions.currentPlatform)`
# (login Google real + Firestore direto do cliente para perfil/histórico — ver
# docs/contracts/firestore-schema.md), com fallback gracioso: se a inicialização falhar, o app cai
# de volta no fluxo guest sem quebrar. A configuração do Firebase em si NÃO é lida via
# --dart-define — ela vem de `lib/firebase_options.dart` (gerado por `flutterfire configure`) e
# dos arquivos nativos de cada plataforma. Projeto real (`smash-gift-1f87d`) já conectado para
# Android (`android/app/google-services.json`) e Web (chaves embutidas em
# `firebase_options.dart`); `ios/Runner/GoogleService-Info.plist` e
# `macos/Runner/GoogleService-Info.plist` ainda não existem, então nessas plataformas (e em Linux
# desktop) a inicialização falha e o fallback guest-safe é usado — ver
# docs/specs/2026-08-12-mobile-technical-design.md. As chaves abaixo ficam documentadas apenas como
# referência do formato esperado; nenhum valor real deve ser colocado neste arquivo de exemplo.
FIREBASE_PROJECT_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=
