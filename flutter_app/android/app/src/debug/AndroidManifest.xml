<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Cleartext HTTP, for talking to a backend running on the developer's
         machine. Declared here and only here: this manifest is merged into
         debug builds and no other, so the release manifest has no reference to
         it and no way to acquire one by accident.

         Verified by phase 15, which greps the merged release manifest. -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
